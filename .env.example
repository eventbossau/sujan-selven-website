# Resend — https://resend.com
# Verify sujanselven.org in Resend before using noreply@sujanselven.org in production.
RESEND_API_KEY=
EMAIL_FROM="Sujan Selven <noreply@sujanselven.org>"
# Production: info@sujanselven.org — use a personal inbox only for local testing
EMAIL_TO=info@sujanselven.org

# Airtable — form submissions are also stored here (optional; emails still send without it)
# Create a Personal Access Token with data.records:write on your base:
# https://airtable.com/create/tokens
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=
# Table names must match exactly (create these tables with the fields listed in README notes)
AIRTABLE_CONTACT_TABLE=Contact
AIRTABLE_GET_INVOLVED_TABLE=Get Involved
